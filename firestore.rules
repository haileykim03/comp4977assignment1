rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    function validNotes(data) {
      return data.notes is string && data.notes.size() <= 500;
    }

    match /UserProfiles/{email} {
      allow read: if signedIn() && email == myEmail();
      allow write: if signedIn()
        && email == myEmail()
        && request.resource.data.userEmail == myEmail()
        && request.resource.data.municipalityId is int;
    }

    match /CandidateSelections/{selectionId} {
      allow read, delete: if signedIn() && resource.data.userEmail == myEmail();

      allow create: if signedIn()
        && request.resource.data.userEmail == myEmail()
        && request.resource.data.id == selectionId
        && request.resource.data.candidateId is int
        && request.resource.data.candidateName is string
        && request.resource.data.candidateName.size() > 0
        && request.resource.data.positionId is int
        && request.resource.data.municipalityId is int
        && request.resource.data.municipalityName is string
        && validNotes(request.resource.data);

      allow update: if signedIn()
        && resource.data.userEmail == myEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'dateModified'])
        && validNotes(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
